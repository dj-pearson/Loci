SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
PORT=3000

# APNs (US-196) — required for the weekly digest and household share pushes.
# APNS_KEY_P8 is the contents of the .p8 auth key downloaded from the Apple
# Developer portal; newlines may be escaped as \n for single-line secret stores.
# Leave unset to disable push delivery (the sidecar logs and continues).
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=app.lociate.ios
# Defaults to the sandbox gateway unless NODE_ENV=production.
APNS_HOST=https://api.sandbox.push.apple.com

# FCM (US-197) — required for Android push. Paste the full service-account JSON
# from the Firebase console (Project settings -> Service accounts -> Generate new
# private key). Newlines in private_key may be escaped as \n.
# Leave unset to disable Android push (the sidecar logs and continues).
FCM_SERVICE_ACCOUNT_JSON=

# Error reporting (US-199). Empty disables it entirely.
SENTRY_DSN=

# Logging (US-215): debug | info | warn | error
LOG_LEVEL=info
