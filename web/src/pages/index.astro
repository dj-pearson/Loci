---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Loci — Your Spatial Memory">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h1 class="text-5xl font-bold tracking-tight text-gray-900">Your Spatial Memory</h1>
    <p class="mt-6 text-xl text-gray-600 max-w-2xl mx-auto">
      Pin voice notes to places. Rediscover them when you return.
    </p>
  </section>
</BaseLayout>
