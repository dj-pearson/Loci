default_platform(:ios)

platform :ios do
  desc "Sync certificates and profiles via match"
  lane :certificates do
    match(type: "appstore", readonly: true)
  end

  desc "Build and run unit tests on simulator"
  lane :test do
    run_tests(
      project: "Lociate.xcodeproj",
      scheme: "Lociate",
      devices: ["iPhone 15"],
      clean: true,
      code_coverage: true,
      output_directory: "./build/test_output",
      output_types: "junit"
    )
  end

  desc "Build and upload to TestFlight (beta)"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true
    )

    match(type: "development", readonly: true)

    build_number = ENV["CI_BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(build_number: build_number)

    build_app(
      project: "Lociate.xcodeproj",
      scheme: "Lociate",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Lociate.ipa"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build and upload to TestFlight"
  lane :release do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true
    )

    match(type: "appstore", readonly: true)

    build_app(
      project: "Lociate.xcodeproj",
      scheme: "Lociate",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Lociate.ipa"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build and submit to App Store for review"
  lane :app_store_release do |options|
    version = options[:version]
    whats_new = options[:whats_new] || "Bug fixes and performance improvements."

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true
    )

    match(type: "appstore", readonly: true)

    build_app(
      project: "Lociate.xcodeproj",
      scheme: "Lociate",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Lociate.ipa"
    )

    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      release_notes: { "en-US" => whats_new },
      submission_information: {
        add_id_info_uses_idfa: false
      },
      precheck_include_in_app_purchases: false
    )
  end
end
