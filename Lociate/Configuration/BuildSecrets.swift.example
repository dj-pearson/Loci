// BuildSecrets.swift.example
//
// LOCAL DEVELOPMENT SETUP:
//   1. Copy this file to BuildSecrets.swift (same directory).
//   2. Fill in values for the services you need to test locally.
//   3. BuildSecrets.swift is .gitignored — never commit real keys.
//
// CI / PRODUCTION:
//   The generate-secrets.sh script creates BuildSecrets.swift from environment
//   variables during CI builds. See .github/workflows/release.yml for the
//   required GitHub Actions secrets.
//
// VALIDATION:
//   BuildSecretsValidator.validate() runs on app launch. In DEBUG it logs
//   warnings for missing values. In RELEASE it will crash if critical secrets
//   (supabaseURL, supabaseAnonKey) are empty or placeholder — this is
//   intentional to prevent shipping unconfigured builds.

import Foundation

enum BuildSecrets {
    // MARK: - Supabase

    /// Base URL for your Supabase instance.
    /// Local dev: "http://localhost:8000" (default Docker Supabase).
    /// Production: Set SUPABASE_URL env var in CI (e.g., "https://your-project.supabase.co").
    static let supabaseURL = "http://localhost:8000"

    /// Supabase anonymous (public) key — safe to embed in the client.
    /// Local dev: Copy from Supabase dashboard or docker-compose output.
    /// Production: Set SUPABASE_ANON_KEY env var in CI.
    static let supabaseAnonKey = "your-local-anon-key"

    // MARK: - RevenueCat

    /// RevenueCat Apple API key for in-app purchases and subscriptions.
    /// Get this from https://app.revenuecat.com → Project → API Keys → Apple.
    /// Production: Set REVENUECAT_API_KEY env var in CI.
    static let revenueCatAPIKey = "appl_REPLACE_WITH_KEY"

    // MARK: - TelemetryDeck

    /// TelemetryDeck app identifier for privacy-focused analytics.
    /// Get this from https://dashboard.telemetrydeck.com → App → Settings.
    /// Production: Set TELEMETRYDECK_APP_ID env var in CI.
    /// Leave empty to disable analytics during local development.
    static let telemetryDeckAppID = ""

    // MARK: - Certificate Pinning

    /// Primary SPKI SHA-256 hash (base64) of your Supabase server's leaf certificate.
    /// Generate with:
    ///   openssl s_client -connect your-host:443 2>/dev/null | \
    ///     openssl x509 -pubkey -noout | \
    ///     openssl pkey -pubin -outform DER | \
    ///     openssl dgst -sha256 -binary | base64
    /// Production: Set CERT_PIN_HASH env var in CI.
    /// Leave empty to disable pinning during local development.
    static let certificatePinHash = ""

    /// Backup pin — typically an intermediate CA so the app survives leaf cert rotation.
    /// Default: Let's Encrypt ISRG Root X1 intermediate.
    /// Production: Optionally override via CERT_BACKUP_PIN_HASH env var in CI.
    static let certificateBackupPinHash = "C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M="

    // MARK: - Request Signing

    /// HMAC-SHA256 shared secret for signing sensitive API mutations.
    /// Must match REQUEST_SIGNING_KEY on the edge function server.
    /// Generate with: openssl rand -hex 32
    /// Production: Set REQUEST_SIGNING_KEY env var in CI.
    /// Leave empty to disable request signing during local development.
    static let requestSigningKey = ""

    // MARK: - Crash Reporting (US-199)

    /// Sentry DSN. Empty disables crash reporting entirely — a contributor build
    /// needs no Sentry account.
    static let sentryDSN = ""
}
