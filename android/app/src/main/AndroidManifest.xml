<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Audio Recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service for recording & location -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Vibration for haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Biometric -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Boot completed for geofence re-registration -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wake lock for background sync -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LociateApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lociate"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lociate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom-scheme deep links from notifications and the widget.
                 US-203: `loci` is registered alongside `lociate` so links already
                 emitted by the iOS widget resolve on Android too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lociate" android:host="locus" />
                <data android:scheme="loci" android:host="locus" />
            </intent-filter>

            <!-- https App Links. autoVerify requires
                 https://lociate.app/.well-known/assetlinks.json to list this
                 package and its Play App Signing SHA-256 fingerprint. Paths mirror
                 the iOS AASA file so both platforms accept the same URLs. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lociate.app" android:pathPrefix="/locus" />
                <data android:scheme="https" android:host="lociate.app" android:pathPrefix="/open" />
                <data android:scheme="https" android:host="www.lociate.app" android:pathPrefix="/locus" />
                <data android:scheme="https" android:host="www.lociate.app" android:pathPrefix="/open" />
            </intent-filter>
        </activity>

        <!-- Geofence Broadcast Receiver -->
        <receiver
            android:name=".service.GeofenceBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.lociate.android.GEOFENCE_EVENT" />
            </intent-filter>
        </receiver>

        <!-- Boot Receiver for geofence re-registration -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- US-197: Firebase Cloud Messaging receiver. Android previously had no
             push transport at all, so household shares and the weekly digest
             reached iOS devices only. -->
        <service
            android:name=".service.LociateMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Fall back to the geofence channel and brand mark if a payload ever
             arrives as a notification message rather than data-only. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="geofence_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Location Foreground Service -->
        <service
            android:name=".service.LocationForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Recording Foreground Service -->
        <service
            android:name=".service.RecordingForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

    </application>

</manifest>
