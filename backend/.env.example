############################################################
# Lociate Backend — Environment Variables
# Copy to .env and fill in real values before deploying
############################################################

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=lociate
POSTGRES_PORT=5432

# ── Supabase JWT ──────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-token-at-least-32-characters-long

# ── Supabase Keys ─────────────────────────────────────────
# Generate anon and service_role keys at:
# https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# ── External URL ──────────────────────────────────────────
# The public-facing URL of your Supabase API (Kong gateway)
API_EXTERNAL_URL=https://api.lociate.app
SITE_URL=https://lociate.app
ADDITIONAL_REDIRECT_URLS=lociate://auth-callback

# ── Apple Sign In ─────────────────────────────────────────
APPLE_CLIENT_ID=app.lociate.ios
APPLE_SECRET=your-apple-sign-in-secret

# ── Realtime ──────────────────────────────────────────────
REALTIME_ENC_KEY=your-realtime-encryption-key
REALTIME_SECRET_KEY_BASE=your-secret-key-base-at-least-64-characters-long-change-me

# ── Service Ports (change if conflicts) ───────────────────
AUTH_PORT=9999
REST_PORT=3001
STORAGE_PORT=5000
REALTIME_PORT=4000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
EDGE_FUNCTIONS_PORT=3100

# ── Edge Functions ────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
